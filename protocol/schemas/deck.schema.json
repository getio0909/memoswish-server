{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Deck",
  "description": "卡组。",
  "type": "object",
  "properties": {
    "card_count": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "description": {
      "type": "string",
      "default": ""
    },
    "id": {
      "type": "string"
    },
    "language": {
      "type": "string"
    },
    "revision": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0
    },
    "tags": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "title": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "title",
    "language",
    "card_count",
    "created_at"
  ]
}
