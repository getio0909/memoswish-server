{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AccountProfile",
  "description": "全局账户概要，不含工作区授权。",
  "type": "object",
  "properties": {
    "display_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "email",
    "display_name"
  ]
}
