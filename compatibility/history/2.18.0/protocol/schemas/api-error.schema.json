{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ApiError",
  "description": "所有非 2xx HTTP 响应的 JSON 结构。",
  "type": "object",
  "properties": {
    "code": {
      "description": "机器可读错误码，例如 `not_found`、`unauthorized`、`quota_exceeded`。",
      "type": "string"
    },
    "message": {
      "description": "人类可读的英文描述。",
      "type": "string"
    }
  },
  "required": [
    "code",
    "message"
  ]
}
