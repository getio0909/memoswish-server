{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AccessSummary",
  "type": "object",
  "properties": {
    "auth_time": {
      "type": [
        "integer",
        "null"
      ],
      "format": "int64"
    },
    "current": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "expires_at": {
      "type": [
        "integer",
        "null"
      ],
      "format": "int64"
    },
    "id": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "label": {
      "type": [
        "string",
        "null"
      ]
    },
    "scopes": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "scopes_limited": {
      "description": "API Token 的显式 scope 中是否有当前角色不再授予的权限。",
      "type": [
        "boolean",
        "null"
      ]
    },
    "status": {
      "type": "string"
    },
    "tenant_id": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "id",
    "kind",
    "status"
  ]
}
