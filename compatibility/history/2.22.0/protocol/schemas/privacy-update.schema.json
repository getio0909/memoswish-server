{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PrivacyUpdate",
  "type": "object",
  "properties": {
    "decision": {
      "type": "boolean"
    },
    "expected_revision": {
      "type": "integer",
      "format": "int64"
    },
    "kind": {
      "type": "string"
    },
    "value": {
      "type": "string",
      "default": ""
    },
    "version": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "expected_revision",
    "kind",
    "version",
    "decision"
  ]
}
