{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LearnerCardControl",
  "type": "object",
  "properties": {
    "buried_until": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "card_id": {
      "type": "string"
    },
    "revision": {
      "type": "integer",
      "format": "int64"
    },
    "suspended": {
      "type": "boolean"
    }
  },
  "required": [
    "card_id",
    "revision",
    "suspended"
  ]
}
