{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SessionResponse",
  "description": "第一方 opaque 会话凭据；refresh 明文仅随签发响应返回。",
  "type": "object",
  "properties": {
    "access_token": {
      "type": "string"
    },
    "account": {
      "$ref": "#/$defs/AccountProfile"
    },
    "expires_in": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "refresh_token": {
      "type": "string"
    },
    "session_id": {
      "type": "string"
    },
    "token_type": {
      "type": "string"
    },
    "workspace": {
      "anyOf": [
        {
          "$ref": "#/$defs/UserProfile"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "access_token",
    "refresh_token",
    "token_type",
    "expires_in",
    "session_id",
    "account"
  ],
  "$defs": {
    "AccountProfile": {
      "description": "全局账户概要，不含工作区授权。",
      "type": "object",
      "properties": {
        "display_name": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "user_id": {
          "type": "string"
        }
      },
      "required": [
        "user_id",
        "email",
        "display_name"
      ]
    },
    "UserProfile": {
      "description": "当前用户概要。",
      "type": "object",
      "properties": {
        "display_name": {
          "type": "string"
        },
        "role": {
          "description": "`owner` | `admin` | `editor` | `learner`。",
          "type": "string"
        },
        "tenant_id": {
          "type": "string"
        },
        "user_id": {
          "type": "string"
        }
      },
      "required": [
        "user_id",
        "tenant_id",
        "display_name",
        "role"
      ]
    }
  }
}
