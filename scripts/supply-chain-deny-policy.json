{
  "graph": {
    "all-features": true
  },
  "advisories": {
    "version": 2,
    "yanked": "deny",
    "unmaintained": "workspace"
  },
  "licenses": {
    "version": 2,
    "confidence-threshold": 0.93,
    "allow": [
      "Apache-2.0",
      "Apache-2.0 WITH LLVM-exception",
      "MIT",
      "BSD-2-Clause",
      "BSD-3-Clause",
      "ISC",
      "Zlib",
      "Unicode-3.0",
      "CDLA-Permissive-2.0",
      "MPL-2.0",
      "0BSD"
    ],
    "unused-allowed-license": "warn"
  },
  "bans": {
    "multiple-versions": "warn",
    "wildcards": "allow",
    "highlight": "all",
    "deny": [
      {
        "name": "openssl"
      },
      {
        "name": "openssl-sys"
      }
    ]
  },
  "sources": {
    "unknown-registry": "deny",
    "unknown-git": "deny",
    "allow-registry": [
      "https://github.com/rust-lang/crates.io-index"
    ],
    "allow-git": []
  }
}
